ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://banco:banco@localhost:5432/banco
# Generar con: openssl rand -hex 32
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-64-caracteres-hex
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Orígenes del frontend, en formato JSON
CORS_ORIGINS=["http://localhost:5173"]
LOGIN_RATE_LIMIT=5/minute
DOCS_ENABLED=true
TIMEZONE=America/Tijuana
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Correo para el cierre diario
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cierres@ejemplo.com
SMTP_SECURITY=starttls

# Cierre diario automático (habilitar en un solo proceso)
SCHEDULER_ENABLED=false
CIERRE_HORA=23
CIERRE_MINUTO=59
CIERRE_ADJUNTAR_PDF=true
